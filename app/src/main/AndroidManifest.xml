<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 6.1.0: قراءة خوادم DNS من الشبكة الحقيقية قبل كل جلسة طرفية -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Required for third-party extensions -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <queries>
        <package android:name="com.github.android" />
        <package android:name="com.termux.x11" />

        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name="com.mahdi.application.MahdiApplication"
        android:allowBackup="true"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Karbon"
        tools:targetApi="tiramisu">
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name="com.mahdi.activities.main.MainActivity"
            android:alwaysRetainTaskState="true"
            android:exported="true"
            android:inputType="textFilter"
            android:launchMode="singleTask"
            android:persistableMode="persistAcrossReboots"
            android:windowSoftInputMode="adjustResize">


            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:mimeType="*/*"
                    android:scheme="file" />
                <data
                    android:mimeType="*/*"
                    android:scheme="content" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.mahdi" />
                <data android:pathPattern=".*\\.xed" />
                <data android:pathPattern=".*\\.xedx" />
            </intent-filter>
        </activity>

        <!-- ═══════════════════════════════════════════════════════════════════════
         4.3.0 — عشر أيقونات أنمي ثلاثية الأبعاد بحرف M.
         كل أيقونة = activity-alias مفعّل/معطّل من:
         الإعدادات ‹ التطبيق ‹ أيقونة التطبيق.
         الافتراضية = IconAnimeRobot (enabled=true)، والباقي معطّل حتى يُختار.
         الخلفيات في values/colors_app_icons.xml والصور في mipmap-*/.
         ═══════════════════════════════════════════════════════════════════════ -->

        <!-- الثعلب · سماوي — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeFox"
            android:theme="@style/Theme.Karbon.Icon.Fox"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_fox"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- القط · بنفسجي — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeCat"
            android:theme="@style/Theme.Karbon.Icon.Cat"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_cat"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- الحرف M المجسّم — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeMark"
            android:theme="@style/Theme.Karbon.Icon.Mark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_mark"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- الروبوت المبرمج · الافتراضية — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeRobot"
            android:theme="@style/Theme.Karbon.Icon.Robot"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_robot"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- البومة · ذهبي — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeOwl"
            android:theme="@style/Theme.Karbon.Icon.Owl"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_owl"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- البطريق · أزرق — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimePenguin"
            android:theme="@style/Theme.Karbon.Icon.Penguin"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_penguin"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- التنين · زمردي — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeDragon"
            android:theme="@style/Theme.Karbon.Icon.Dragon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_dragon"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- الأرنب · وردي — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeBunny"
            android:theme="@style/Theme.Karbon.Icon.Bunny"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_bunny"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- الباندا · فضي — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimePanda"
            android:theme="@style/Theme.Karbon.Icon.Panda"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_panda"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- الأكسولوتل · ليموني — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeAxolotl"
            android:theme="@style/Theme.Karbon.Icon.Axolotl"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_axolotl"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- الهمستر · ذهبي — تُفعَّل من: الإعدادات ‹ التطبيق ‹ أيقونة التطبيق -->
        <activity-alias
            android:name="com.mahdi.application.icon.IconAnimeHamster"
            android:theme="@style/Theme.Karbon.Icon.Hamster"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_anime_hamster"
            android:label="@string/app_name"
            android:targetActivity="com.mahdi.activities.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ═══════════════════════════════════════════════════════════════════════
         4.3.0 — المكوّنات التي يجب أن تبقى دائمًا.
         (حُذفت خطأً في 4.3.0 عند استبدال كتلة الأيقونات، فصار التطبيق يخرج
          مباشرة: أي استثناء لا يجد CrashActivity فيموت بصمت، والإعدادات
          والمشاركة واستوديو الحزم لا تفتح.)
         ═══════════════════════════════════════════════════════════════════════ -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- شاشة الانهيار: بدونها يموت التطبيق بصمت عند أي خطأ -->
        <activity
            android:name="com.mahdi.crashhandler.CrashActivity"
            android:exported="false" />
        <activity
            android:name="com.mahdi.activities.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.mahdi.project.ProjectCreatorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.mahdi.extension.api.ExtensionActivity"
            android:exported="false" />
    </application>
</manifest>
