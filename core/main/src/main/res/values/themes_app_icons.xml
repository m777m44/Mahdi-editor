<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      5.0.0 — شاشة بداية مطابقة لكل أيقونة.

      كل activity-alias في البيان يحمل ثيمه الخاص، فيظهر في شاشة البداية
      **نفس** الأيقونة التي اختارها المستخدم على الشاشة الرئيسية، بخلفية لونها.
      نُعلن السمتين بصيغتين: صيغة مكتبة core-splashscreen (تعمل على أندرويد 8–11)
      وسمة المنصّة `android:` (تعمل على أندرويد 12+).
      المظهر بعد انتهاء شاشة البداية يبقى `Theme.Karbon` كما هو.
    -->

    <style name="Theme.Karbon.Icon.Fox" parent="Theme.Karbon">
        <item name="windowSplashScreenBackground">@color/ic_bg_anime_fox</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_anime_fox</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ic_bg_anime_fox</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher_anime_fox</item>
        <item name="postSplashScreenTheme">@style/Theme.Karbon</item>
    </style>

