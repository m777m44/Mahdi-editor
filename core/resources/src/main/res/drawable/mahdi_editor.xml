    android:viewportWidth="960"
    android:viewportHeight="960">

    <!-- الخلفية: مربّع بحواف دائرية كبيرة -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M240,80 L720,80 A160,160 0 0 1 880,240 L880,720 A160,160 0 0 1 720,880 L240,880 A160,160 0 0 1 80,720 L80,240 A160,160 0 0 1 240,80 Z M240,200 A40,40 0 0 0 200,240 L200,720 A40,40 0 0 0 240,760 L720,760 A40,40 0 0 0 760,720 L760,240 A40,40 0 0 0 720,200 Z" />

    <!-- حرف M سميك في المنتصف -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M300,690 L300,300 Q300,270 332,270 Q352,270 364,290 L480,470 L596,290 Q608,270 628,270 Q660,270 660,300 L660,690 Q660,716 636,716 Q612,716 612,690 L612,430 L512,584 Q500,602 480,602 Q460,602 448,584 L348,430 L348,690 Q348,716 324,716 Q300,716 300,690 Z" />
